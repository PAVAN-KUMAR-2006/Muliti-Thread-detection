# Copy to .env and change every value. Never commit .env.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=sentinel
# Used when the backend runs on your host. docker-compose overrides the host with "db".
DATABASE_URL=postgresql+psycopg://sentinel:change-this-password@localhost:5432/sentinel
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
ACCESS_MINUTES=15
REFRESH_DAYS=7
RESET_MINUTES=30
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
